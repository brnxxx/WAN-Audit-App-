# Core application
SECRET_KEY=replace-with-a-long-random-secret
SESSION_MAX_AGE_SECONDS=604800

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=monitoring
DB_USER=root
DB_PASSWORD=your_mysql_password

# GNS3
GNS3_URL=http://127.0.0.1:3080
GNS3_USERNAME=
GNS3_PASSWORD=

# Device access
DEVICE_SSH_USERNAME=
DEVICE_SSH_PASSWORD=

# Browser origins allowed to call the API (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5500,http://127.0.0.1:5500
